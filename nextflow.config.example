conda.enabled = true

executor {
    queueSize = 4
}
process {
    cpus = 1
}

params {
    outdir = "results"
    batch_size = 200
    gene_timeout = 900
    genes_file = "${projectDir}/reference_data/expressed_coding_isoforms_with_relative_tpm_threshold_1_geneIDs.txt"
    ppi_binding_site_file = "${projectDir}/reference_data/ppi_binding_sites.tsv"
    cds_fasta_file = "${projectDir}/reference_data/Homo_sapiens.GRCh38.cds.all.fa.gz"
    uniprot_mapping_file = "${projectDir}/reference_data/Homo_sapiens.GRCh38.109.uniprot.tsv.gz"
    gtf_file = "${projectDir}/reference_data/Homo_sapiens.GRCh38.109.gtf.gz"
    interpro_domains_file = "${projectDir}/reference_data/Homo_sapiens.GRCh38.interpro_domains.tsv.gz"
    pfam_domains_file = "${projectDir}/reference_data/Homo_sapiens.GRCh38.pfam_domains.tsv.gz"
    interpro_entry_types_file = "${projectDir}/reference_data/interpro_90.0_entry.list"
    domains = "ppi_domain dbi"
    keep_overlapping_domains = false
    identical_only = false
    match_mode = "segment"
    expression_files = "${projectDir}/expressed_coding_isoforms_with_relative_tpm_threshold_1.tsv"
    // Per domain type: kept = 1 if fully covered, else sigmoid(alpha * (coverage - beta));
    // impact factor = 1 - mean kept. Fitted by code/scripts/fit_asif_sigmoid.py -x.
    asif_dna_binding_alpha = 48.8
    asif_dna_binding_beta = 0.958
    asif_ppi_alpha = 17.0
    asif_ppi_beta = 0.965
    // Parameters for domains of both types (or no recorded type): "dna_binding" or "ppi".
    asif_both_type = "dna_binding"
}
